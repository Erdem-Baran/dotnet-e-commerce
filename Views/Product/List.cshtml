@model List<Product>;

<section class="mt-3">
        <div class="container">
            <h3 class="h-4 mb-1 mb-lg-3">Product List</h3>

            @if(Model.Count == 0)
            {
                <div class="alert alert-info">No products found in this category.</div>
            }

            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
                @foreach (var item in Model)
                {
                    <div class="col-3">
                        @await Html.PartialAsync("partials/_ProductCard", item)
                    </div>
                }
            </div>
        </div>
    </section>