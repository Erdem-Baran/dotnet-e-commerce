@model List<Product>;
@{
    ViewData["Title"] = "Home Page";
}

    <section class="mt-3">
        <div class="container">
            <div class="card">
            <div class="row p-1 p-lg-2 gx-2">
                <div class="col-lg-3 d-none d-lg-block">
                    <!-- menu -->
                    @await Html.PartialAsync("partials/_Menu")
                </div>
                <div class="col-lg-9">
                    <!-- slider -->
                    @await Html.PartialAsync("partials/_Slider")
                </div>
            </div>
        </div>
        </div>
    </section>

    <section class="mt-3">
        <div class="container">
            <h3 class="h-4 mb-1 mb-lg-3">Son Eklenenler</h3>
           <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                @await Html.PartialAsync("partials/_ProductCard", item)
            </div>
        }
    </div>
        </div>
    </section>
